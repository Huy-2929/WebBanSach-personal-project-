@model WebBanHang.Models.Author
@{
    ViewData["Title"] = "Thêm Tác Giả Mới";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1"><i class="bi bi-person-plus text-primary"></i> Thêm Tác Giả Mới</h1>
        <p class="text-muted mb-0">Nhập thông tin tác giả sách</p>
    </div>
    <a asp-area="Admin" asp-controller="Authors" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-lg-5">
                <form asp-area="Admin" asp-controller="Authors" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="AuthorName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="AuthorName" class="form-control" placeholder="Ví dụ: Nguyễn Nhật Ánh, Dale Carnegie..." autofocus />
                        <span asp-validation-for="AuthorName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Biography" class="form-label fw-semibold"></label>
                        <textarea asp-for="Biography" class="form-control" rows="5" placeholder="Tóm tắt tiểu sử, sự nghiệp và phong cách sáng tác của tác giả..."></textarea>
                        <span asp-validation-for="Biography" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-area="Admin" asp-controller="Authors" asp-action="Index" class="btn btn-outline-secondary px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            <i class="bi bi-check-lg me-1"></i> Lưu Tác Giả
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
