@model WebBanHang.Models.Category
@{
    ViewData["Title"] = $"Chỉnh Sửa Danh Mục - {Model.CategoryName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1"><i class="bi bi-pencil-square text-primary"></i> Chỉnh Sửa Danh Mục</h1>
        <p class="text-muted mb-0">Cập nhật thông tin cho danh mục: <strong>@Model.CategoryName</strong> (Mã #@Model.CategoryId)</p>
    </div>
    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-lg-5">
                <form asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@Model.CategoryId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CategoryId" />
                    <input type="hidden" asp-for="CreatedAt" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="CategoryName" class="form-control" />
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            <i class="bi bi-save me-1"></i> Lưu Thay Đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
