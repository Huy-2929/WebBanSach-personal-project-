@model WebBanHang.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Bảng Điều Khiển Quản Trị";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1"><i class="bi bi-speedometer2 text-primary"></i> Tổng Quan Quản Trị</h1>
        <p class="text-muted mb-0">Thống kê hoạt động kinh doanh và dữ liệu hệ thống WebBanSach</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Books" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Thêm sách mới
        </a>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-receipt me-1"></i> Xem tất cả đơn
        </a>
    </div>
</div>

<!-- Stat Cards Grid -->
<div class="row g-3 mb-4">
    <!-- Total Revenue -->
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card border-start border-4 border-success">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Tổng doanh thu</span>
                    <div class="stat-number text-success">@Model.TotalRevenue.ToString("N0") <small class="fs-6">đ</small></div>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-circle">
                    <i class="bi bi-cash-coin fs-2"></i>
                </div>
            </div>
            <div class="text-muted small mt-2">Doanh thu từ các đơn không bị hủy</div>
        </div>
    </div>

    <!-- Total Orders -->
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card border-start border-4 border-primary">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Tổng đơn hàng</span>
                    <div class="stat-number text-primary">@Model.TotalOrders</div>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                    <i class="bi bi-receipt-cutoff fs-2"></i>
                </div>
            </div>
            <div class="text-muted small mt-2">Tổng số lượt mua hàng</div>
        </div>
    </div>

    <!-- Total Users -->
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card border-start border-4 border-info">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Khách hàng & Người dùng</span>
                    <div class="stat-number text-info">@Model.TotalUsers</div>
                </div>
                <div class="p-3 bg-info-subtle text-info rounded-circle">
                    <i class="bi bi-people-fill fs-2"></i>
                </div>
            </div>
            <div class="text-muted small mt-2">Tài khoản đã đăng ký</div>
        </div>
    </div>

    <!-- Total Books -->
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card border-start border-4 border-warning">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Tổng đầu sách</span>
                    <div class="stat-number text-warning">@Model.TotalBooks</div>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                    <i class="bi bi-journal-bookmark-fill fs-2"></i>
                </div>
            </div>
            <div class="text-muted small mt-2">Đang có trong danh mục</div>
        </div>
    </div>

    <!-- Total Categories -->
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card border-start border-4 border-secondary">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Tổng danh mục</span>
                    <div class="stat-number text-secondary">@Model.TotalCategories</div>
                </div>
                <div class="p-3 bg-secondary-subtle text-secondary rounded-circle">
                    <i class="bi bi-grid-fill fs-2"></i>
                </div>
            </div>
            <div class="text-muted small mt-2">Phân loại sách</div>
        </div>
    </div>

    <!-- Total Authors & Publishers -->
    <div class="col-sm-6 col-xl-4">
        <div class="stat-card border-start border-4 border-dark">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Tác giả / Nhà xuất bản</span>
                    <div class="stat-number text-dark">@Model.TotalAuthors / @Model.TotalPublishers</div>
                </div>
                <div class="p-3 bg-dark-subtle text-dark rounded-circle">
                    <i class="bi bi-building fs-2"></i>
                </div>
            </div>
            <div class="text-muted small mt-2">Đối tác & tác giả</div>
        </div>
    </div>
</div>

<!-- Recent Orders Section -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="card-title fw-bold mb-0">
            <i class="bi bi-clock-history me-1 text-primary"></i> Đơn Hàng Gần Đây
        </h5>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">
            Xem tất cả đơn hàng <i class="bi bi-arrow-right"></i>
        </a>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentOrders != null && Model.RecentOrders.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 90px;">Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Điện thoại</th>
                            <th style="width: 170px;">Ngày đặt</th>
                            <th style="width: 150px;" class="text-end">Tổng tiền</th>
                            <th style="width: 140px;" class="text-center">Trạng thái</th>
                            <th style="width: 120px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.RecentOrders)
                        {
                            <tr>
                                <td class="fw-bold text-primary">#@o.OrderId</td>
                                <td>
                                    <div class="fw-semibold">@o.ShippingName</div>
                                    <div class="small text-muted">@o.User?.Email</div>
                                </td>
                                <td>@o.ShippingPhone</td>
                                <td class="small text-muted">@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end fw-bold text-danger">@o.TotalAmount.ToString("N0") đ</td>
                                <td class="text-center">
                                    <span class="badge badge-status-@o.Status px-3 py-2">
                                        @o.Status
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@o.OrderId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> Xem
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                Chưa có đơn hàng nào được tạo trong hệ thống.
            </div>
        }
    </div>
</div>
