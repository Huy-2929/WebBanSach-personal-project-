@model IEnumerable<WebBanHang.Models.Order>
@{
    ViewData["Title"] = "Quản Lý Đơn Hàng";
    var statuses = ViewBag.Statuses as string[] ?? Array.Empty<string>();
    string? currentStatus = ViewBag.CurrentStatus as string;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1"><i class="bi bi-receipt text-primary"></i> Quản Lý Đơn Hàng</h1>
        <p class="text-muted mb-0">Tổng số: <strong>@Model.Count()</strong> đơn hàng</p>
    </div>
</div>

<!-- Status Filter Tabs -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-2">
        <ul class="nav nav-pills">
            <li class="nav-item">
                <a class="nav-link @(string.IsNullOrEmpty(currentStatus) || currentStatus == "All" ? "active" : "")" asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="All">
                    Tất cả đơn
                </a>
            </li>
            @foreach (var s in statuses)
            {
                <li class="nav-item">
                    <a class="nav-link @(currentStatus == s ? "active" : "")" asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="@s">
                        @s
                    </a>
                </li>
            }
        </ul>
    </div>
</div>

<!-- Orders Table -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 90px;">Mã đơn</th>
                    <th style="width: 170px;">Ngày đặt</th>
                    <th>Khách hàng</th>
                    <th>Người nhận & Địa chỉ</th>
                    <th style="width: 140px;" class="text-end">Tổng tiền</th>
                    <th style="width: 140px;" class="text-center">Trạng thái</th>
                    <th style="width: 120px;" class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">#@item.OrderId</td>
                            <td class="small text-muted">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="fw-semibold">@(item.User?.FullName ?? "Khách vãng lai")</div>
                                <div class="small text-muted">@item.User?.Email</div>
                            </td>
                            <td>
                                <div><strong>@item.ShippingName</strong> (@item.ShippingPhone)</div>
                                <div class="small text-muted text-truncate" style="max-width: 280px;" title="@item.ShippingAddress">
                                    <i class="bi bi-geo-alt"></i> @item.ShippingAddress
                                </div>
                            </td>
                            <td class="text-end fw-bold text-danger">@item.TotalAmount.ToString("N0") đ</td>
                            <td class="text-center">
                                <span class="badge badge-status-@item.Status px-3 py-2">
                                    @item.Status
                                </span>
                            </td>
                            <td class="text-center">
                                <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Xem & Xử lý
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                            Không có đơn hàng nào trong mục này.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
