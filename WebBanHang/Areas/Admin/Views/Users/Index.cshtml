@model IEnumerable<WebBanHang.Models.User>
@{
    ViewData["Title"] = "Quản Lý Người Dùng";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1"><i class="bi bi-people text-primary"></i> Quản Lý Người Dùng</h1>
        <p class="text-muted mb-0">Tổng số: <strong>@Model.Count()</strong> tài khoản đã đăng ký</p>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Điện thoại</th>
                    <th>Địa chỉ</th>
                    <th style="width: 120px;" class="text-center">Vai trò</th>
                    <th style="width: 120px;" class="text-center">Số đơn hàng</th>
                    <th style="width: 150px;">Ngày tạo</th>
                    <th style="width: 120px;" class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="text-muted fw-bold">#@user.UserId</td>
                            <td class="fw-semibold">@user.FullName</td>
                            <td><i class="bi bi-envelope text-muted me-1"></i>@user.Email</td>
                            <td class="small">@(string.IsNullOrEmpty(user.Phone) ? "—" : user.Phone)</td>
                            <td class="small text-muted text-truncate" style="max-width: 200px;" title="@user.Address">
                                @(string.IsNullOrEmpty(user.Address) ? "—" : user.Address)
                            </td>
                            <td class="text-center">
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-danger px-3 py-2">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary px-3 py-2">Customer</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">
                                    @user.Orders.Count đơn
                                </span>
                            </td>
                            <td class="small text-muted">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <a asp-area="Admin" asp-controller="Users" asp-action="EditRole" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-primary" title="Đổi quyền">
                                    <i class="bi bi-shield-lock"></i> Đổi quyền
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            Chưa có người dùng nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
