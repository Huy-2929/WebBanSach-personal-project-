@{
    ViewData["Title"] = "Không Có Quyền Truy Cập";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="p-5 bg-white rounded-4 shadow-sm border">
            <i class="bi bi-shield-lock-fill text-danger" style="font-size: 5rem;"></i>
            <h1 class="h3 fw-bold mt-4 text-dark">Truy Cập Bị Từ Chối</h1>
            <p class="text-muted mt-2 mb-4">
                Bạn không có quyền truy cập vào trang này. Khu vực này chỉ dành cho người dùng có quyền quản trị viên (Admin).
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-house-door"></i> Về trang chủ
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-person"></i> Đăng nhập bằng tài khoản khác
                </a>
            </div>
        </div>
    </div>
</div>
