@model IEnumerable<WebBanHang.Models.Author>
@{
    ViewData["Title"] = "Danh Sách Tác Giả";
}

<div class="mb-4">
    <h1 class="h3 fw-bold">Các Tác Giả Nổi Tiếng</h1>
    <p class="text-muted">Khám phá tác phẩm của các cây bút xuất sắc</p>
</div>

<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        @foreach (var author in Model)
        {
            <div class="col-md-4 col-sm-6">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle bg-secondary-subtle text-secondary p-3 me-3">
                                <i class="bi bi-person-fill fs-3"></i>
                            </div>
                            <div>
                                <h5 class="card-title fw-bold mb-0">@author.AuthorName</h5>
                                <span class="badge bg-primary-subtle text-primary small">@(author.Books?.Count ?? 0) tác phẩm</span>
                            </div>
                        </div>
                        <p class="card-text text-muted flex-grow-1 small" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @(string.IsNullOrWhiteSpace(author.Biography) ? "Đang cập nhật tiểu sử tác giả..." : author.Biography)
                        </p>
                        <a asp-action="Details" asp-route-id="@author.AuthorId" class="btn btn-outline-primary btn-sm mt-auto">
                            Xem các tác phẩm <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <p class="text-muted">Chưa có tác giả nào.</p>
        </div>
    }
</div>
