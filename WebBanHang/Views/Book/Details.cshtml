@model WebBanHang.Models.Book
@{
    ViewData["Title"] = Model.BookName;
    var relatedBooks = ViewBag.RelatedBooks as List<WebBanHang.Models.Book> ?? new List<WebBanHang.Models.Book>();
}

<!-- Breadcrumbs -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Book" asp-action="Index">Sách</a></li>
        @if (Model.Category != null)
        {
            <li class="breadcrumb-item"><a asp-controller="Category" asp-action="Details" asp-route-id="@Model.CategoryId">@Model.Category.CategoryName</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">@Model.BookName</li>
    </ol>
</nav>

<div class="card shadow-sm border-0 mb-5">
    <div class="card-body p-4 p-lg-5">
        <div class="row g-5">
            <!-- Book Cover -->
            <div class="col-md-5 text-center">
                <div class="p-3 bg-light rounded-4 d-inline-block shadow-sm" style="max-width: 100%;">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? Url.Content("~/images/default-book.svg") : Model.ImageUrl)"
                         alt="@Model.BookName" class="img-fluid rounded-3" style="max-height: 450px; object-fit: contain;" />
                </div>
            </div>

            <!-- Book Information -->
            <div class="col-md-7">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill mb-2">
                    @(Model.Category?.CategoryName ?? "Chưa phân loại")
                </span>
                <h1 class="h2 fw-bold text-dark mb-3">@Model.BookName</h1>

                <div class="mb-3 d-flex flex-wrap gap-4 text-muted small">
                    <div>
                        <i class="bi bi-person-fill text-primary"></i> Tác giả: 
                        <strong class="text-dark">@(Model.Author?.AuthorName ?? "Chưa rõ")</strong>
                    </div>
                    <div>
                        <i class="bi bi-building text-primary"></i> NXB: 
                        <strong class="text-dark">@(Model.Publisher?.PublisherName ?? "Chưa rõ")</strong>
                    </div>
                    @if (Model.PublishedYear.HasValue)
                    {
                        <div>
                            <i class="bi bi-calendar3 text-primary"></i> Năm XB: 
                            <strong class="text-dark">@Model.PublishedYear</strong>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ISBN))
                    {
                        <div>
                            <i class="bi bi-upc-scan text-primary"></i> ISBN: 
                            <strong class="text-dark">@Model.ISBN</strong>
                        </div>
                    }
                </div>

                <div class="p-3 bg-light rounded-3 my-4">
                    <div class="text-muted small mb-1">Giá bán chính hãng:</div>
                    <div class="display-6 fw-bold text-danger">@Model.Price.ToString("N0") VNĐ</div>
                    <div class="mt-2">
                        @if (Model.Quantity > 0)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> Còn hàng (còn @Model.Quantity cuốn)</span>
                        }
                        else
                        {
                            <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Tạm hết hàng</span>
                        }
                    </div>
                </div>

                @if (Model.Quantity > 0)
                {
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="my-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookId" value="@Model.BookId" />
                        <div class="row g-3 align-items-center">
                            <div class="col-auto">
                                <label for="quantityInput" class="col-form-label fw-semibold">Số lượng mua:</label>
                            </div>
                            <div class="col-auto">
                                <input type="number" id="quantityInput" name="quantity" class="form-control text-center" value="1" min="1" max="@Model.Quantity" style="width: 90px;" />
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-primary btn-lg px-4">
                                    <i class="bi bi-cart-plus-fill me-2"></i> Thêm vào giỏ hàng
                                </button>
                            </div>
                        </div>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning my-4">
                        <i class="bi bi-exclamation-triangle"></i> Cuốn sách này hiện đang tạm hết hàng. Quý khách vui lòng quay lại sau!
                    </div>
                }

                <div class="mt-4">
                    <h5 class="fw-bold border-bottom pb-2 mb-3">Mô tả nội dung</h5>
                    <div class="text-secondary" style="line-height: 1.8; white-space: pre-line;">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "Đang cập nhật nội dung cho cuốn sách này..." : Model.Description)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Related Books -->
@if (relatedBooks.Any())
{
    <section class="mt-5">
        <h3 class="section-title">Sách Cùng Danh Mục</h3>
        <div class="row g-4">
            @foreach (var rBook in relatedBooks)
            {
                <div class="col-6 col-md-3">
                    <div class="book-card">
                        <div class="book-cover-container" style="height: 200px;">
                            <a asp-controller="Book" asp-action="Details" asp-route-id="@rBook.BookId">
                                <img src="@(string.IsNullOrEmpty(rBook.ImageUrl) ? Url.Content("~/images/default-book.svg") : rBook.ImageUrl)"
                                     alt="@rBook.BookName" class="book-cover-img" />
                            </a>
                        </div>
                        <div class="book-card-body p-3">
                            <a asp-controller="Book" asp-action="Details" asp-route-id="@rBook.BookId" class="text-decoration-none">
                                <h4 class="book-title fs-6" title="@rBook.BookName">@rBook.BookName</h4>
                            </a>
                            <div class="book-price fs-6">@rBook.Price.ToString("N0") VNĐ</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}
