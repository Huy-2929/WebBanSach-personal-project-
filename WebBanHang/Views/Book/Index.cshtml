@model IEnumerable<WebBanHang.Models.Book>
@{
    ViewData["Title"] = "Danh Sách Sách";
    var categories = ViewBag.Categories as List<WebBanHang.Models.Category> ?? new List<WebBanHang.Models.Category>();
    int? currentCat = ViewBag.CurrentCategory as int?;
    string? currentSort = ViewBag.CurrentSort as string;
    string? currentSearch = ViewBag.CurrentSearch as string;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1">Tủ Sách Trực Tuyến</h1>
        <p class="text-muted mb-0">Tìm thấy <strong>@Model.Count()</strong> cuốn sách phù hợp</p>
    </div>
</div>

<!-- Filter and Search Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-controller="Book" asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Tên sách, tác giả, ISBN..." value="@currentSearch" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select">
                    <option value="">-- Tất cả danh mục --</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.CategoryId" selected="@(currentCat == cat.CategoryId)">@cat.CategoryName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="sortOrder" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(currentSort))">Mới nhất</option>
                    <option value="price_asc" selected="@(currentSort == "price_asc")">Giá: Thấp đến Cao</option>
                    <option value="price_desc" selected="@(currentSort == "price_desc")">Giá: Cao đến Thấp</option>
                    <option value="name_asc" selected="@(currentSort == "name_asc")">Tên: A - Z</option>
                    <option value="name_desc" selected="@(currentSort == "name_desc")">Tên: Z - A</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-funnel"></i> Lọc
                </button>
                <a asp-controller="Book" asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Books Grid -->
<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        @foreach (var book in Model)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="book-card">
                    <div class="book-cover-container">
                        <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId">
                            <img src="@(string.IsNullOrEmpty(book.ImageUrl) ? Url.Content("~/images/default-book.svg") : book.ImageUrl)"
                                 alt="@book.BookName" class="book-cover-img" />
                        </a>
                        @if (book.Quantity <= 0)
                        {
                            <span class="badge bg-danger position-absolute top-0 start-0 m-2">Hết hàng</span>
                        }
                        else
                        {
                            <span class="badge bg-success position-absolute top-0 start-0 m-2">Còn @book.Quantity cuốn</span>
                        }
                    </div>
                    <div class="book-card-body">
                        <span class="badge bg-light text-secondary border mb-1 align-self-start">@(book.Category?.CategoryName ?? "Sách")</span>
                        <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId" class="text-decoration-none">
                            <h3 class="book-title" title="@book.BookName">@book.BookName</h3>
                        </a>
                        <div class="book-author">
                            <i class="bi bi-person me-1"></i>@(book.Author?.AuthorName ?? "Chưa rõ")
                        </div>
                        <div class="book-price">
                            @book.Price.ToString("N0") VNĐ
                        </div>
                        <div class="book-card-footer mt-auto">
                            <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId" class="btn btn-outline-secondary btn-sm flex-grow-1">
                                <i class="bi bi-info-circle"></i> Chi tiết
                            </a>
                            @if (book.Quantity > 0)
                            {
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookId" value="@book.BookId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-primary btn-sm" title="Thêm vào giỏ">
                                        <i class="bi bi-cart-plus"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 py-5 text-center">
            <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-secondary">Không tìm thấy sách nào</h4>
            <p class="text-muted">Vui lòng thử tìm kiếm với từ khóa khác hoặc bỏ các bộ lọc.</p>
            <a asp-controller="Book" asp-action="Index" class="btn btn-primary mt-2">Xem tất cả sách</a>
        </div>
    }
</div>
