@model List<WebBanHang.ViewModels.CartItemViewModel>
@{
    ViewData["Title"] = "Giỏ Hàng";
    decimal total = Model?.Sum(i => i.SubTotal) ?? 0;
}

<div class="mb-4">
    <h1 class="h3 fw-bold"><i class="bi bi-cart3 text-primary"></i> Giỏ Hàng Của Bạn</h1>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-4">
        <!-- Cart Items List -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table cart-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 100px;">Ảnh</th>
                                <th>Tên sách</th>
                                <th style="width: 130px;">Đơn giá</th>
                                <th style="width: 150px;" class="text-center">Số lượng</th>
                                <th style="width: 140px;" class="text-end">Thành tiền</th>
                                <th style="width: 60px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? Url.Content("~/images/default-book.svg") : item.ImageUrl)"
                                             alt="@item.BookName" class="rounded border p-1" style="width: 60px; height: 80px; object-fit: contain;" />
                                    </td>
                                    <td>
                                        <a asp-controller="Book" asp-action="Details" asp-route-id="@item.BookId" class="fw-semibold text-dark text-decoration-none">
                                            @item.BookName
                                        </a>
                                        <div class="small text-muted">Kho còn: @item.StockQuantity cuốn</div>
                                    </td>
                                    <td class="fw-semibold">
                                        @item.Price.ToString("N0") đ
                                    </td>
                                    <td>
                                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex align-items-center justify-content-center gap-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookId" value="@item.BookId" />
                                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.StockQuantity"
                                                   class="form-control form-control-sm text-center" style="width: 65px;" onchange="this.form.submit()" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Cập nhật"><i class="bi bi-arrow-repeat"></i></button>
                                        </form>
                                    </td>
                                    <td class="text-end fw-bold text-danger">
                                        @item.SubTotal.ToString("N0") đ
                                    </td>
                                    <td class="text-center">
                                        <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookId" value="@item.BookId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa khỏi giỏ" onclick="return confirm('Bạn có chắc muốn xóa cuốn sách này?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white p-3 d-flex justify-content-between align-items-center">
                    <a asp-controller="Book" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i> Tiếp tục mua sách
                    </a>
                    <form asp-controller="Cart" asp-action="Clear" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Bạn muốn xóa toàn bộ giỏ hàng?');">
                            <i class="bi bi-trash3"></i> Xóa toàn bộ giỏ hàng
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 80px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Tóm Tắt Đơn Hàng</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tổng số lượng sách:</span>
                        <span class="fw-semibold">@Model.Sum(x => x.Quantity) cuốn</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="fw-semibold">@total.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Phí vận chuyển:</span>
                        <span class="text-success fw-semibold">Miễn phí</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5 fw-bold">Tổng thanh toán:</span>
                        <span class="fs-4 fw-bold text-danger">@total.ToString("N0") VNĐ</span>
                    </div>
                    <div class="d-grid">
                        <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary btn-lg fw-bold">
                            <i class="bi bi-credit-card-2-front me-1"></i> Tiến Hành Đặt Hàng
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0 py-5 text-center">
        <div class="card-body">
            <i class="bi bi-cart-x text-muted" style="font-size: 5rem;"></i>
            <h3 class="mt-3 fw-bold text-secondary">Giỏ hàng của bạn đang trống</h3>
            <p class="text-muted mb-4">Hãy dạo một vòng cửa hàng và chọn những cuốn sách ưng ý nhé!</p>
            <a asp-controller="Book" asp-action="Index" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-book"></i> Khám phá sách ngay
            </a>
        </div>
    </div>
}
