@model WebBanHang.Models.Category
@{
    ViewData["Title"] = "Thể loại: " + Model.CategoryName;
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Category" asp-action="Index">Danh mục</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.CategoryName</li>
    </ol>
</nav>

<div class="p-4 bg-white rounded-3 shadow-sm mb-4 border">
    <div class="d-flex align-items-center gap-3">
        <div class="rounded-circle bg-primary-subtle text-primary p-3">
            <i class="bi bi-bookmarks-fill fs-2"></i>
        </div>
        <div>
            <h1 class="h3 fw-bold mb-1">Thể loại: @Model.CategoryName</h1>
            <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(Model.Description) ? "Tổng hợp các tác phẩm thuộc danh mục " + Model.CategoryName : Model.Description)</p>
        </div>
    </div>
</div>

<div class="row g-4">
    @if (Model.Books != null && Model.Books.Any())
    {
        @foreach (var book in Model.Books)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="book-card">
                    <div class="book-cover-container">
                        <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId">
                            <img src="@(string.IsNullOrEmpty(book.ImageUrl) ? Url.Content("~/images/default-book.svg") : book.ImageUrl)"
                                 alt="@book.BookName" class="book-cover-img" />
                        </a>
                        @if (book.Quantity <= 0)
                        {
                            <span class="badge bg-danger position-absolute top-0 start-0 m-2">Hết hàng</span>
                        }
                    </div>
                    <div class="book-card-body">
                        <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId" class="text-decoration-none">
                            <h3 class="book-title" title="@book.BookName">@book.BookName</h3>
                        </a>
                        <div class="book-author">
                            <i class="bi bi-person me-1"></i>@(book.Author?.AuthorName ?? "Chưa rõ")
                        </div>
                        <div class="book-price">
                            @book.Price.ToString("N0") VNĐ
                        </div>
                        <div class="book-card-footer mt-auto">
                            <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId" class="btn btn-outline-secondary btn-sm flex-grow-1">
                                <i class="bi bi-info-circle"></i> Chi tiết
                            </a>
                            @if (book.Quantity > 0)
                            {
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookId" value="@book.BookId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-primary btn-sm" title="Thêm vào giỏ">
                                        <i class="bi bi-cart-plus"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
            <h5 class="mt-3 text-secondary">Chưa có sách nào trong thể loại này</h5>
            <a asp-controller="Book" asp-action="Index" class="btn btn-outline-primary btn-sm mt-2">Xem danh sách sách khác</a>
        </div>
    }
</div>
