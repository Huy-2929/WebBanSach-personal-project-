@model IEnumerable<WebBanHang.Models.Category>
@{
    ViewData["Title"] = "Thể Loại Sách";
}

<div class="mb-4">
    <h1 class="h3 fw-bold">Danh Mục Thể Loại Sách</h1>
    <p class="text-muted">Chọn thể loại để khám phá các tựa sách hay nhất</p>
</div>

<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        @foreach (var cat in Model)
        {
            <div class="col-md-4 col-sm-6">
                <div class="card h-100 shadow-sm border-0 hover-card">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle bg-primary-subtle text-primary p-3 me-3">
                                <i class="bi bi-bookmark-star-fill fs-3"></i>
                            </div>
                            <div>
                                <h5 class="card-title fw-bold mb-0">@cat.CategoryName</h5>
                                <span class="badge bg-secondary-subtle text-secondary small">@(cat.Books?.Count ?? 0) cuốn sách</span>
                            </div>
                        </div>
                        <p class="card-text text-muted flex-grow-1 small">
                            @(string.IsNullOrWhiteSpace(cat.Description) ? "Khám phá các đầu sách thuộc thể loại " + cat.CategoryName : cat.Description)
                        </p>
                        <a asp-action="Details" asp-route-id="@cat.CategoryId" class="btn btn-outline-primary btn-sm mt-auto">
                            Xem sách trong mục này <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <p class="text-muted">Chưa có danh mục nào.</p>
        </div>
    }
</div>
