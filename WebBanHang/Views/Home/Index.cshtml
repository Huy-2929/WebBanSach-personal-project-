                            <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId" class="text-decoration-none">
                                <h3 class="book-title" title="@book.BookName">@book.BookName</h3>
                            </a>
                            <div class="book-author">
                                <i class="bi bi-person me-1"></i>@(book.Author?.AuthorName ?? "Chưa rõ")
                            </div>
                            <div class="book-price">
                                @book.Price.ToString("N0") VNĐ
                            </div>
                            <div class="book-card-footer mt-auto">
                                <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId" class="btn btn-outline-secondary btn-sm flex-grow-1">
                                    <i class="bi bi-info-circle"></i> Chi tiết
                                </a>
                                @if (book.Quantity > 0)
                                {
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookId" value="@book.BookId" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-primary btn-sm" title="Thêm vào giỏ">
                                            <i class="bi bi-cart-plus"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12"><p class="text-muted">Chưa có sách mới nào.</p></div>
        }
    </div>
</section>
