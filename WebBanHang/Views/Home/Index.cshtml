@model WebBanHang.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Hero Banner -->
<div class="hero-banner">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="hero-title">Khám Phá Thế Giới Qua Từng Trang Sách</h1>
            <p class="hero-subtitle">Hàng ngàn đầu sách văn học, kinh tế, kỹ năng sống, tiểu thuyết được tuyển chọn kỹ lưỡng. Giao hàng tận nơi toàn quốc.</p>
            <div class="d-flex gap-3">
                <a asp-controller="Book" asp-action="Index" class="btn btn-warning btn-lg fw-bold px-4">
                    <i class="bi bi-cart-plus me-1"></i> Khám phá ngay
                </a>
                <a asp-controller="Category" asp-action="Index" class="btn btn-outline-light btn-lg px-4">
                    <i class="bi bi-grid me-1"></i> Thể loại sách
                </a>
            </div>
        </div>
        <div class="col-lg-4 d-none d-lg-block text-center">
            <i class="bi bi-book text-white-50" style="font-size: 8rem;"></i>
        </div>
    </div>
</div>

<!-- Danh mục sách -->
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="section-title mb-0">Danh Mục Sách</h2>
        <a asp-controller="Category" asp-action="Index" class="text-primary text-decoration-none fw-semibold">
            Xem tất cả <i class="bi bi-arrow-right"></i>
        </a>
    </div>
    <div class="row g-3">
        @if (Model.Categories != null && Model.Categories.Any())
        {
            @foreach (var cat in Model.Categories)
            {
                <div class="col-6 col-md-4 col-lg-2">
                    <a asp-controller="Category" asp-action="Details" asp-route-id="@cat.CategoryId" class="category-card">
                        <i class="bi bi-bookmarks-fill fs-3 text-primary mb-2 d-block"></i>
                        <h6 class="mb-0 fw-bold">@cat.CategoryName</h6>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="col-12"><p class="text-muted">Chưa có danh mục nào.</p></div>
        }
    </div>
</section>

<!-- Sách nổi bật -->
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="section-title mb-0">Sách Nổi Bật</h2>
        <a asp-controller="Book" asp-action="Index" class="text-primary text-decoration-none fw-semibold">
            Xem thêm <i class="bi bi-arrow-right"></i>
        </a>
    </div>
    <div class="row g-4">
        @if (Model.FeaturedBooks != null && Model.FeaturedBooks.Any())
        {
            @foreach (var book in Model.FeaturedBooks)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="book-card">
                        <div class="book-cover-container">
                            <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId">
                                <img src="@(string.IsNullOrEmpty(book.ImageUrl) ? Url.Content("~/images/default-book.svg") : book.ImageUrl)"
                                     alt="@book.BookName" class="book-cover-img" />
                            </a>
                            @if (book.Quantity <= 0)
                            {
                                <span class="badge bg-danger position-absolute top-0 start-0 m-2">Hết hàng</span>
                            }
                        </div>
                        <div class="book-card-body">
                            <span class="badge bg-light text-secondary border mb-1 align-self-start">@(book.Category?.CategoryName ?? "Sách")</span>
                            <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId" class="text-decoration-none">
                                <h3 class="book-title" title="@book.BookName">@book.BookName</h3>
                            </a>
                            <div class="book-author">
                                <i class="bi bi-person me-1"></i>@(book.Author?.AuthorName ?? "Chưa rõ")
                            </div>
                            <div class="book-price">
                                @book.Price.ToString("N0") VNĐ
                            </div>
                            <div class="book-card-footer mt-auto">
                                <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId" class="btn btn-outline-secondary btn-sm flex-grow-1">
                                    <i class="bi bi-info-circle"></i> Chi tiết
                                </a>
                                @if (book.Quantity > 0)
                                {
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookId" value="@book.BookId" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-primary btn-sm" title="Thêm vào giỏ">
                                            <i class="bi bi-cart-plus"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12"><p class="text-muted">Chưa có sách nào.</p></div>
        }
    </div>
</section>

