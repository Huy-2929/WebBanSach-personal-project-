@model WebBanHang.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh Toán Đơn Hàng";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index">Giỏ hàng</a></li>
        <li class="breadcrumb-item active" aria-current="page">Thanh toán</li>
    </ol>
</nav>

<div class="mb-4">
    <h1 class="h3 fw-bold"><i class="bi bi-credit-card-2-front text-primary"></i> Thông Tin Thanh Toán</h1>
    <p class="text-muted">Vui lòng kiểm tra kỹ thông tin giao hàng và danh sách sản phẩm trước khi hoàn tất đặt hàng.</p>
</div>

<form asp-controller="Order" asp-action="Checkout" method="post">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <!-- Shipping Information Form -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title fw-bold mb-0 text-primary">
                        <i class="bi bi-geo-alt-fill me-1"></i> Thông Tin Giao Hàng
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="ShippingName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                            <input asp-for="ShippingName" class="form-control" placeholder="Nguyễn Văn A" />
                        </div>
                        <span asp-validation-for="ShippingName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ShippingPhone" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                            <input asp-for="ShippingPhone" class="form-control" placeholder="0912345678" />
                        </div>
                        <span asp-validation-for="ShippingPhone" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ShippingAddress" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-geo-alt"></i></span>
                            <input asp-for="ShippingAddress" class="form-control" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố" />
                        </div>
                        <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Note" class="form-label fw-semibold"></label>
                        <textarea asp-for="Note" class="form-control" rows="3" placeholder="Ghi chú giao hàng (ví dụ: giao giờ hành chính, gọi trước khi đến...)"></textarea>
                        <span asp-validation-for="Note" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-info d-flex align-items-center mb-0" role="alert">
                        <i class="bi bi-cash-coin fs-4 me-2"></i>
                        <div>
                            <strong>Phương thức thanh toán:</strong> Thanh toán khi nhận hàng (COD). Quý khách sẽ thanh toán tiền mặt trực tiếp cho nhân viên giao hàng.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 sticky-top" style="top: 80px;">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title fw-bold mb-0">
                        <i class="bi bi-basket3 me-1 text-primary"></i> Đơn Hàng Của Bạn (@Model.CartItems.Sum(x => x.Quantity) cuốn)
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="order-items-list mb-3" style="max-height: 280px; overflow-y: auto;">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? Url.Content("~/images/default-book.svg") : item.ImageUrl)"
                                     alt="@item.BookName" class="rounded border p-1" style="width: 48px; height: 60px; object-fit: contain;" />
                                <div class="flex-grow-1">
                                    <div class="fw-semibold text-truncate small" style="max-width: 200px;" title="@item.BookName">@item.BookName</div>
                                    <div class="text-muted small">@item.Price.ToString("N0") đ x @item.Quantity</div>
                                </div>
                                <div class="fw-bold text-end text-danger small">
                                    @item.SubTotal.ToString("N0") đ
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="fw-semibold">@Model.TotalAmount.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Phí vận chuyển:</span>
                        <span class="text-success fw-semibold">Miễn phí</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5 fw-bold">Tổng thanh toán:</span>
                        <span class="fs-4 fw-bold text-danger">@Model.TotalAmount.ToString("N0") VNĐ</span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold">
                            <i class="bi bi-check2-circle me-1"></i> Xác Nhận Đặt Hàng
                        </button>
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại giỏ hàng
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
