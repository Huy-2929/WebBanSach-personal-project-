@model WebBanHang.Models.Order
@{
    ViewData["Title"] = $"Chi Tiết Đơn Hàng #{Model.OrderId}";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Order" asp-action="MyOrders">Đơn hàng của tôi</a></li>
        <li class="breadcrumb-item active" aria-current="page">Đơn #@Model.OrderId</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1">
            Đơn Hàng <span class="text-primary">#@Model.OrderId</span>
        </h1>
        <p class="text-muted mb-0">Đặt lúc: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge badge-status-@Model.Status fs-6 px-3 py-2">
            @Model.Status
        </span>
        <a asp-controller="Order" asp-action="MyOrders" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Customer Delivery Info -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title fw-bold mb-0 text-primary">
                    <i class="bi bi-geo-alt-fill me-1"></i> Thông Tin Giao Hàng
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-2">
                    <span class="text-muted small">Người nhận:</span>
                    <div class="fw-bold fs-6">@Model.ShippingName</div>
                </div>
                <div class="mb-2">
                    <span class="text-muted small">Số điện thoại:</span>
                    <div class="fw-semibold"><i class="bi bi-telephone text-primary me-1"></i> @Model.ShippingPhone</div>
                </div>
                <div class="mb-2">
                    <span class="text-muted small">Địa chỉ nhận hàng:</span>
                    <div><i class="bi bi-geo text-danger me-1"></i> @Model.ShippingAddress</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div class="mt-3 p-3 bg-light rounded-3 small">
                        <span class="fw-semibold text-muted">Ghi chú đơn hàng:</span>
                        <div class="fst-italic text-secondary mt-1">@Model.Note</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Order Status Summary -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title fw-bold mb-0 text-primary">
                    <i class="bi bi-info-circle-fill me-1"></i> Tiến Trình Đơn Hàng
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <span class="text-muted small">Trạng thái hiện tại:</span>
                    <div class="mt-1">
                        <span class="badge badge-status-@Model.Status fs-6 px-3 py-2">
                            @Model.Status
                        </span>
                    </div>
                </div>
                <div class="mb-2">
                    <span class="text-muted small">Phương thức thanh toán:</span>
                    <div class="fw-semibold">Thanh toán khi nhận hàng (COD)</div>
                </div>
                <div class="mb-2">
                    <span class="text-muted small">Tổng số mặt hàng:</span>
                    <div class="fw-semibold">@Model.OrderDetails.Sum(x => x.Quantity) cuốn sách</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Ordered Items Table -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="card-title fw-bold mb-0">
            <i class="bi bi-journal-check me-1 text-primary"></i> Danh Sách Sản Phẩm Đã Đặt
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;" class="text-center">#</th>
                        <th style="width: 100px;">Ảnh</th>
                        <th>Tên sách</th>
                        <th style="width: 140px;" class="text-end">Đơn giá</th>
                        <th style="width: 120px;" class="text-center">Số lượng</th>
                        <th style="width: 160px;" class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int index = 1; }
                    @foreach (var detail in Model.OrderDetails)
                    {
                        <tr>
                            <td class="text-center text-muted">@(index++)</td>
                            <td>
                                <img src="@(string.IsNullOrEmpty(detail.Book?.ImageUrl) ? Url.Content("~/images/default-book.svg") : detail.Book.ImageUrl)"
                                     alt="@detail.Book?.BookName" class="rounded border p-1" style="width: 48px; height: 64px; object-fit: contain;" />
                            </td>
                            <td>
                                @if (detail.Book != null)
                                {
                                    <a asp-controller="Book" asp-action="Details" asp-route-id="@detail.BookId" class="fw-semibold text-dark text-decoration-none">
                                        @detail.Book.BookName
                                    </a>
                                }
                                else
                                {
                                    <span class="fw-semibold">Sách #@detail.BookId</span>
                                }
                            </td>
                            <td class="text-end">@detail.UnitPrice.ToString("N0") đ</td>
                            <td class="text-center fw-semibold">@detail.Quantity</td>
                            <td class="text-end fw-bold text-danger">@((detail.Quantity * detail.UnitPrice).ToString("N0")) đ</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light">
                        <td colspan="5" class="text-end fw-bold fs-5 py-3">Tổng giá trị đơn hàng:</td>
                        <td class="text-end fw-bold text-danger fs-5 py-3">@Model.TotalAmount.ToString("N0") VNĐ</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
