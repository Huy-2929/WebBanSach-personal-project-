@model IEnumerable<WebBanHang.Models.Order>
@{
    ViewData["Title"] = "Đơn Hàng Của Tôi";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1"><i class="bi bi-receipt text-primary"></i> Lịch Sử Đơn Hàng</h1>
        <p class="text-muted mb-0">Theo dõi trạng thái và lịch sử tất cả đơn hàng bạn đã đặt</p>
    </div>
    <a asp-controller="Book" asp-action="Index" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-cart-plus me-1"></i> Tiếp tục mua hàng
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">Mã đơn</th>
                        <th style="width: 170px;">Ngày đặt</th>
                        <th>Người nhận</th>
                        <th style="width: 120px;" class="text-center">Số món</th>
                        <th style="width: 160px;" class="text-end">Tổng tiền</th>
                        <th style="width: 140px;" class="text-center">Trạng thái</th>
                        <th style="width: 120px;" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">#@order.OrderId</td>
                            <td class="small text-muted">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="fw-semibold">@order.ShippingName</div>
                                <div class="small text-muted"><i class="bi bi-telephone"></i> @order.ShippingPhone</div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">
                                    @order.OrderDetails.Sum(d => d.Quantity) cuốn
                                </span>
                            </td>
                            <td class="text-end fw-bold text-danger">
                                @order.TotalAmount.ToString("N0") đ
                            </td>
                            <td class="text-center">
                                <span class="badge badge-status-@order.Status px-3 py-2">
                                    @order.Status
                                </span>
                            </td>
                            <td class="text-center">
                                <a asp-controller="Order" asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0 py-5 text-center">
        <div class="card-body">
            <i class="bi bi-bag-x text-muted" style="font-size: 5rem;"></i>
            <h3 class="mt-3 fw-bold text-secondary">Bạn chưa có đơn hàng nào</h3>
            <p class="text-muted mb-4">Các đơn hàng bạn đặt sẽ xuất hiện ở đây để tiện theo dõi tiến độ.</p>
            <a asp-controller="Book" asp-action="Index" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-book"></i> Mua sách ngay bây giờ
            </a>
        </div>
    </div>
}
