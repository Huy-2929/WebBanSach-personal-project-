@model WebBanHang.Models.Order
@{
    ViewData["Title"] = "Đặt Hàng Thành Công";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 text-center mb-4">
            <div class="card-body p-4 p-lg-5">
                <div class="rounded-circle bg-success-subtle text-success d-inline-flex p-3 mb-3">
                    <i class="bi bi-check-circle-fill display-4"></i>
                </div>
                <h1 class="h2 fw-bold text-success mb-2">Đặt Hàng Thành Công!</h1>
                <p class="text-muted mb-4">Cảm ơn bạn đã mua sách tại WebBanSach. Mã đơn hàng của bạn là <strong>#@Model.OrderId</strong>.</p>
                
                <div class="d-flex justify-content-center gap-3 mb-4">
                    <a asp-controller="Order" asp-action="MyOrders" class="btn btn-primary">
                        <i class="bi bi-receipt me-1"></i> Xem đơn hàng của tôi
                    </a>
                    <a asp-controller="Book" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-book me-1"></i> Tiếp tục mua sắm
                    </a>
                </div>
            </div>
        </div>

        <!-- Order Information Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-info-circle text-primary me-1"></i> Chi Tiết Đơn Hàng #@Model.OrderId
                </h5>
                <span class="badge badge-status-@Model.Status px-3 py-2">
                    @Model.Status
                </span>
            </div>
            <div class="card-body p-4">
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <h6 class="text-muted fw-bold small text-uppercase mb-2">Thông tin người nhận</h6>
                        <div class="fw-semibold">@Model.ShippingName</div>
                        <div class="text-muted small"><i class="bi bi-telephone me-1"></i> @Model.ShippingPhone</div>
                        <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i> @Model.ShippingAddress</div>
                        @if (!string.IsNullOrEmpty(Model.Note))
                        {
                            <div class="text-muted small mt-1"><i class="bi bi-chat-left-text me-1"></i> Ghi chú: <em>@Model.Note</em></div>
                        }
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted fw-bold small text-uppercase mb-2">Thông tin thanh toán</h6>
                        <div class="small mb-1">Ngày đặt: <strong>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</strong></div>
                        <div class="small mb-1">Phương thức: <strong>Thanh toán khi nhận hàng (COD)</strong></div>
                        <div class="small">Trạng thái: <strong class="text-primary">@Model.Status</strong></div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center" style="width: 100px;">Số lượng</th>
                                <th class="text-end" style="width: 140px;">Đơn giá</th>
                                <th class="text-end" style="width: 160px;">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.OrderDetails)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@(string.IsNullOrEmpty(detail.Book?.ImageUrl) ? Url.Content("~/images/default-book.svg") : detail.Book.ImageUrl)"
                                                 alt="@detail.Book?.BookName" class="rounded border p-1" style="width: 48px; height: 60px; object-fit: contain;" />
                                            <div>
                                                <div class="fw-semibold">@(detail.Book?.BookName ?? "Sách #" + detail.BookId)</div>
                                                <div class="text-muted small">Mã sách: @detail.BookId</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center fw-semibold">@detail.Quantity</td>
                                    <td class="text-end">@detail.UnitPrice.ToString("N0") đ</td>
                                    <td class="text-end fw-bold text-danger">@((detail.Quantity * detail.UnitPrice).ToString("N0")) đ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold fs-5">Tổng thanh toán:</td>
                                <td class="text-end fw-bold text-danger fs-5">@Model.TotalAmount.ToString("N0") VNĐ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
