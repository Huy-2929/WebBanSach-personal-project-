@using WebBanHang.Helpers
@using WebBanHang.ViewModels
@{
    var cart = Context.Session.GetObject<List<CartItemViewModel>>("Cart");
    int cartCount = cart?.Sum(x => x.Quantity) ?? 0;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Web Bán Sách</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-bookstore sticky-top">
            <div class="container">
                <a class="brand-logo" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half"></i> WebBanSach
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarBookstoreContent"
                        aria-controls="navbarBookstoreContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarBookstoreContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Book" asp-action="Index">
                                <i class="bi bi-journal-bookmark"></i> Sách
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Category" asp-action="Index">
                                <i class="bi bi-grid"></i> Danh mục
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Author" asp-action="Index">
                                <i class="bi bi-people"></i> Tác giả
                            </a>
                        </li>
                    </ul>

                    <!-- Search Form in Navbar -->
                    <form class="d-flex me-3 my-2 my-lg-0" asp-controller="Book" asp-action="Index" method="get">
                        <div class="input-group">
                            <input class="form-control" type="search" name="search" placeholder="Tìm tên sách, tác giả, ISBN..." aria-label="Search" value="@Context.Request.Query["search"]">
                            <button class="btn btn-outline-primary" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    <ul class="navbar-nav mb-2 mb-lg-0 align-items-center">
                        <!-- Shopping Cart -->
                        <li class="nav-item me-2">
                            <a class="btn btn-outline-secondary cart-btn-link" asp-controller="Cart" asp-action="Index" title="Giỏ hàng">
                                <i class="bi bi-cart3 fs-5"></i>
                                <span class="d-lg-none ms-1">Giỏ hàng</span>
                                @if (cartCount > 0)
                                {
                                    <span class="cart-badge">@cartCount</span>
                                }
                            </a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5"></i>
                                    <span>@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userDropdown">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item text-danger fw-semibold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-1"></i> Quản trị Admin
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item" asp-controller="Order" asp-action="MyOrders">
                                            <i class="bi bi-receipt me-1"></i> Đơn hàng của tôi
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-secondary">
                                                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary me-2" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="py-4">
        <div class="container">
            <!-- Alert Notifications -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <footer class="bookstore-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="text-white mb-3"><i class="bi bi-book-half text-primary"></i> Web Bán Sách</h5>
                    <p class="small">Hệ thống phân phối sách trực tuyến hàng đầu. Đa dạng thể loại, giao hàng nhanh chóng, phục vụ tận tâm.</p>
                </div>
                <div class="col-md-4">
                    <h5 class="text-white mb-3">Liên kết nhanh</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right"></i> Trang chủ</a></li>
                        <li class="mb-2"><a asp-controller="Book" asp-action="Index"><i class="bi bi-chevron-right"></i> Danh mục sách</a></li>
                        <li class="mb-2"><a asp-controller="Cart" asp-action="Index"><i class="bi bi-chevron-right"></i> Giỏ hàng</a></li>
                        <li class="mb-2"><a asp-controller="Account" asp-action="Login"><i class="bi bi-chevron-right"></i> Tài khoản</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5 class="text-white mb-3">Liên hệ hỗ trợ</h5>
                    <p class="small mb-1"><i class="bi bi-geo-alt-fill me-2"></i> Hà Nội, Việt Nam</p>
                    <p class="small mb-1"><i class="bi bi-telephone-fill me-2"></i> Hotline: 1900 6868</p>
                    <p class="small mb-1"><i class="bi bi-envelope-fill me-2"></i> support@webbansach.vn</p>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <div class="text-center small">
                &copy; @DateTime.Now.Year WebBanSach - ASP.NET Core MVC & Entity Framework Core. Tất cả quyền được bảo lưu.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
